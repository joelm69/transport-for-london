# Kafka for the arrivals pipeline (single KRaft node, localhost only). Installed by
# deploy/setup_kafka.sh. Logs: journalctl -u tfl-kafka and /var/log/kafka
[Unit]
Description=Kafka broker for TfL arrivals (single node, localhost only)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=kafka
Environment=KAFKA_HEAP_OPTS=-Xms192m -Xmx192m
Environment=LOG_DIR=/var/log/kafka
ExecStart=/opt/kafka/bin/kafka-server-start.sh /etc/kafka/server.properties
Restart=on-failure
RestartSec=30
TimeoutStopSec=60
LimitNOFILE=65536
# Heap 192 MB + JVM native ~30 MB measured; the cap leaves room for file cache.
MemoryMax=360M
# If memory runs out, the kernel kills Kafka first (collectors are -500).
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
