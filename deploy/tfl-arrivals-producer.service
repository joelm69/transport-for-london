# TfL arrivals producer: polls TfL arrivals, publishes to Kafka. Design: docs/endpoints/arrivals.md.
# Installed by deploy/setup_kafka.sh. Logs: journalctl -u tfl-arrivals-producer -f
[Unit]
Description=TfL arrivals producer
Wants=tfl-kafka.service network-online.target
After=tfl-kafka.service network-online.target

[Service]
Type=simple
User=joelmathooko
WorkingDirectory=/home/joelmathooko/tfl-pipeline
ExecStart=/home/joelmathooko/tfl-pipeline/.venv/bin/python -m src.streaming.producer
Environment=PYTHONUNBUFFERED=1
Environment=KAFKA_BOOTSTRAP=127.0.0.1:9092
Restart=always
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=90
# Measured peaks on the VM (2026-10-22): 79 MB with Tube + tram, 127 MB after adding the
# 12 bus routes (three responses held at once when fetched in parallel). 180M leaves margin.
MemoryMax=180M
# Killed before the collectors (-500), after Kafka (500), if memory runs out.
OOMScoreAdjust=300

[Install]
WantedBy=multi-user.target
